# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# dev server logs
/dev-server*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- W1 checkpoint hygiene -------------------------------------------------
# Build / packaging logs
/apk-build*.log
/gradle-build*.log
/dev-qa-server*.log
/static-qa.log

# QA screenshot artifacts
/qa-*.png

# Stray OS/tool artifacts
/nul
*.hermes-tmp.*

# Large generated binary assets (reproducible via scripts/)
#   scripts/download-pages.mjs      -> public/quran/pages/*.webp
#   scripts/generate-icons.ps1      -> app icons
# ayah-meta.json is generated too, but it is small (65 KB), required at runtime
# and asserted by the harnesses, so it is tracked rather than gitignored.
/public/quran/pages/
/public/audio/*.mp3
/android/app/src/main/res/raw/*.mp3
/public/wardi-icon-1024.png

# One-off QA / debug scratch scripts (test + build harnesses are tracked)
/scripts/cdp-*.js
/scripts/qa-*.js
/scripts/qa-*.cjs
/scripts/investigate-*.js
/scripts/mobile-qa*.js
/scripts/headless-qa*.js
/scripts/headless-qa*.mjs
/scripts/headless-test.js
/scripts/chrome-debug.js
/scripts/check-tabs*.js
/scripts/check-pages.js
/scripts/verify-api*.js
/scripts/verify-api*.mjs
/scripts/verify-pattern*.js
/scripts/verify-pattern*.mjs
/scripts/tcp-test.js
/scripts/parse-pages.js
/scripts/test-null.js
/scripts/browser-qa.js
/scripts/recover-css.mjs
