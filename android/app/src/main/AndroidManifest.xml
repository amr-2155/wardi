<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Home-screen prayer widgets. All three sizes render from the same
             payload the app pushes, so they can never drift from the app. -->
        <receiver
            android:name=".WardiPrayerWidgetStrip"
            android:exported="true"
            android:label="@string/wardi_widget_strip_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wardi_prayer_widget_strip" />
        </receiver>

        <receiver
            android:name=".WardiPrayerWidgetNext"
            android:exported="true"
            android:label="@string/wardi_widget_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wardi_prayer_widget_next" />
        </receiver>

        <receiver
            android:name=".WardiPrayerWidgetOverview"
            android:exported="true"
            android:label="@string/wardi_widget_overview_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wardi_prayer_widget_overview" />
        </receiver>

        <!-- Redraws at the next prayer boundary / midnight, and after a boot or
             a clock change. Works with the app closed: it reads the stored
             payload and always re-arms the next boundary. -->
        <receiver
            android:name=".WardiWidgetRefresh"
            android:exported="false">
            <intent-filter>
                <action android:name="com.wardi.app.action.REFRESH_WIDGETS" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Re-arm the widget refresh alarm after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Web Vibration API: without this the dhikr "done" pulse is silently
         dropped by the WebView, which is why the counter never felt like it
         responded on the phone. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
