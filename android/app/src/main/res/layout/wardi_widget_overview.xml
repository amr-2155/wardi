<?xml version="1.0" encoding="utf-8"?>
<!--
  Wardi overview widget — 4×3.
  Header: Hijri (start) · Gregorian (end).
  Location row with a pin (hidden when no place name is cached).
  Five prayers in columns, the next one highlighted; sunrise + CTA at the foot.
  Colors and layout direction are bound at runtime by WardiWidgetRenderer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wardi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wardi_widget_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Dates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/ov_hijri"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="١٨ ربيع الآخر ١٤٤٨ هـ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E8EFE9"
                android:maxLines="1" />
            <TextView
                android:id="@+id/ov_gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="٥ نوفمبر ٢٠٢٦ م"
                android:textSize="10sp"
                android:textColor="#9AA89F"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Location -->
        <LinearLayout
            android:id="@+id/ov_location_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/ov_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="القاهرة"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E8EFE9"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:id="@+id/ov_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/wardi_widget_line_dark" />

        <!-- Prayer columns -->
        <LinearLayout
            android:id="@+id/ov_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ov_cell_fajr"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/ov_name_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفجر"
                    android:textSize="10sp"
                    android:textColor="#9AA89F"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/ov_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="٥:٣٤ ص"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E8EFE9"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_cell_dhuhr"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/ov_name_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الظهر"
                    android:textSize="10sp"
                    android:textColor="#9AA89F"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/ov_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="١٢:٠٣ م"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E8EFE9"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_cell_asr"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/ov_name_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العصر"
                    android:textSize="10sp"
                    android:textColor="#9AA89F"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/ov_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="٤:٢٦ م"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E8EFE9"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_cell_maghrib"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/ov_name_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المغرب"
                    android:textSize="10sp"
                    android:textColor="#9AA89F"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/ov_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="٧:٠٧ م"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E8EFE9"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_cell_isha"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/ov_name_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العشاء"
                    android:textSize="10sp"
                    android:textColor="#9AA89F"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/ov_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="٨:٢٠ م"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E8EFE9"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/ov_sunrise"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="الشروق ٦:٥٦ ص"
                android:textSize="10sp"
                android:textColor="#9AA89F"
                android:maxLines="1" />
            <TextView
                android:id="@+id/ov_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wardi_widget_view_all"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#D9B366"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
