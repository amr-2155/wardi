<?xml version="1.0" encoding="utf-8"?>
<!--
  Wardi prayer overview — 4×3.
  Hijri + Gregorian date, location, all five prayers (next highlighted) and
  sunrise in the footer.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="150dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="400dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/wardi_widget_overview"
    android:previewLayout="@layout/wardi_widget_overview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/wardi_widget_overview_desc" />
