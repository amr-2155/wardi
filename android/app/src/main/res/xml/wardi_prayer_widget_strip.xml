<?xml version="1.0" encoding="utf-8"?>
<!--
  Wardi prayer strip — 4×1.
  Home-screen cells: 4 wide, 1 tall on Android 12+ (targetCellWidth/Height).
  Older launchers fall back to minWidth/minHeight (one 70dp row).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="220dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="140dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/wardi_widget_strip"
    android:previewLayout="@layout/wardi_widget_strip"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/wardi_widget_strip_desc" />
